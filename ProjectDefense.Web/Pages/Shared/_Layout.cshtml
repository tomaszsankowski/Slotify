<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProjectDefense.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProjectDefense.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Project Defense</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity.IsAuthenticated)
                        {
                            var isStudent = User.IsInRole("Student");
                            var isSupervisor = User.IsInRole("Supervisor");

                            if (!isStudent && !isSupervisor)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-warning fw-bold" asp-area="" asp-page="/ChooseRole">Choose Your Role</a>
                                </li>
                            }
                            if (isSupervisor)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-page="/Rooms/Index">Rooms</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-page="/Supervisor/Availabilities/Index">My Availabilities</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-page="/Supervisor/Reservations/Index">All Reservations</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-page="/Supervisor/Students">Students</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-page="/Supervisor/BlockPeriod">Block Period</a>
                                </li>
                                <li class="nav-item">
	                                <a class="nav-link text-dark" asp-area="" asp-page="/Supervisor/UnblockPeriod">Unblock Period</a>
                                </li>
                                <li class="nav-item">
	                                <a class="nav-link text-dark" asp-area="" asp-page="/Supervisor/Export">Export Reservations</a>
                                </li>
                            }
                            else if (isStudent)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-page="/Student/Reservations/Index">Reservations</a>
                                </li>
                            }
                        }
                        else
                        {
	                        <li class="nav-item">
		                        <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
	                        </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            Tomasz Sankowski s193363 Project Defense 2025
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>