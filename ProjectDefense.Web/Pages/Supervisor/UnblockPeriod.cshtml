@page
@model ProjectDefense.Web.Pages.Supervisor.UnblockPeriodModel
@{
    ViewData["Title"] = "Unblock Period";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <h4>Select a date and time range to unblock.</h4>
            <hr />
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-group mb-3">
                <label asp-for="Input.StartTime" class="form-label"></label>
                <input asp-for="Input.StartTime" class="form-control" />
                <span asp-validation-for="Input.StartTime" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Input.EndTime" class="form-label"></label>
                <input asp-for="Input.EndTime" class="form-control" />
                <span asp-validation-for="Input.EndTime" class="text-danger"></span>
            </div>

            <button type="submit" class="w-100 btn btn-lg btn-success">Unblock Period</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}