@page
@model ProjectDefense.Web.Pages.Supervisor.ExportModel
@{
    ViewData["Title"] = "Export Reservation Data";
}

<h2>@ViewData["Title"]</h2>

<div class="row">
    <div class="col-md-6">
        <section>
            <form method="post">
                <h4>Export criteria</h4>
                <hr />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group mb-3">
                    <label asp-for="Input.RoomId" class="form-label"></label>
                    <select asp-for="Input.RoomId" asp-items="Model.Rooms" class="form-control">
                        <option value="">-- Choose room --</option>
                    </select>
                    <span asp-validation-for="Input.RoomId" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Input.StartDate" class="form-label"></label>
                    <input asp-for="Input.StartDate" class="form-control" />
                    <span asp-validation-for="Input.StartDate" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Input.EndDate" class="form-label"></label>
                    <input asp-for="Input.EndDate" class="form-control" />
                    <span asp-validation-for="Input.EndDate" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Input.ExportFormat" class="form-label"></label>
                    <div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" asp-for="Input.ExportFormat" value="txt" checked>
                            <label class="form-check-label">TXT</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" asp-for="Input.ExportFormat" value="xlsx">
                            <label class="form-check-label">XLSX</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" asp-for="Input.ExportFormat" value="pdf">
                            <label class="form-check-label">PDF</label>
                        </div>
                    </div>
                    <span asp-validation-for="Input.ExportFormat" class="text-danger"></span>
                </div>
                <button type="submit" class="w-100 btn btn-lg btn-primary">Export</button>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}