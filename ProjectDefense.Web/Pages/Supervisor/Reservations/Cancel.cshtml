@page
@model ProjectDefense.Web.Pages.Supervisor.Reservations.CancelModel

@{
    ViewData["Title"] = "Cancel";
}

<h1>Cancel</h1>

<h3>Are you sure you want to cancel this reservation?</h3>
<div>
    <h4>Reservation</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Reservation.SupervisorAvailability.Room)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Reservation.SupervisorAvailability.Room.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Reservation.StartTime)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Reservation.StartTime)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Reservation.EndTime)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Reservation.EndTime)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Reservation.Student)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Reservation.Student.UserName)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Reservation.Id" />
        <input type="submit" value="Cancel" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
